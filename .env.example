# JARVIS AI Configuration
# Copy this file to .env.local and fill in your actual values
# Do NOT commit .env.local to the repository

# ─── AI Provider ───────────────────────────────────────────────
# Currently only Groq is active and tested.
# Do NOT add other provider keys until P17 Multi-Provider Intelligence.
AI_PROVIDER=groq

# Groq API Key — get yours at https://console.groq.com/
# This is the ONLY required credential.
AI_API_KEY=

# Model — openai/gpt-oss-120b is the recommended model for JARVIS.
# Other Groq models: llama-3.3-70b-versatile, llama-3.1-8b-instant, qwen/qwen3.6-27b
AI_MODEL=openai/gpt-oss-120b

# Optional: override max retries (default: 3)
# AI_MAX_RETRIES=3

# Optional: override request timeout in ms (default: 30000)
# AI_TIMEOUT=30000

# Optional: custom base URL for local/proxied models
# AI_BASE_URL=http://localhost:8000/v1

# ─── Next.js ──────────────────────────────────────────────────
NODE_ENV=development
