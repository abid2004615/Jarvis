# JARVIS AI Configuration
# Copy this file to .env.local and fill in your actual values
# Do NOT commit .env.local to the repository

# AI Provider Selection
# Options: "openai", "anthropic", "xai", or "groq"
AI_PROVIDER=groq

# AI Provider API Key
# Never commit this to the repository
# Get your API key from https://platform.openai.com/api-keys (OpenAI)
# https://console.anthropic.com/ (Anthropic)
# https://console.x.ai/ (xAI Grok)
# or https://console.groq.com/ (Groq)
AI_API_KEY=

# AI Provider Base URL (optional)
# Use for local LM Studio, self-hosted models, or API proxies
# AI_BASE_URL=http://localhost:8000/v1

# AI Model Selection
# For OpenAI: gpt-4-turbo, gpt-4, gpt-3.5-turbo, etc.
# For Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307, etc.
# For xAI: grok-4.6, grok-4.3, etc.
# For Groq: llama-3.3-70b-versatile, llama-3.1-8b-instant, openai/gpt-oss-120b, qwen/qwen3.6-27b, etc.
# AI_MODEL=llama-3.3-70b-versatile

# AI Request Configuration
# Maximum number of retries for API requests
# AI_MAX_RETRIES=3

# Request timeout in milliseconds
# AI_TIMEOUT=30000

# Next.js Environment
NODE_ENV=development
