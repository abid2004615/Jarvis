{
  "name": "jarvis-assistant",
  "version": "1.0.0",
  "description": "JARVIS — Intelligent Personal Assistant for macOS",
  "author": "JARVIS",
  "private": true,
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "setup": "node scripts/setup-vosk-model.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:compile && electron .",
    "electron:build": "npm run build && npm run electron:compile",
    "package": "npm run setup && npm run electron:build && electron-builder --mac",
    "package:dir": "npm run setup && npm run electron:build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.jarvis.assistant",
    "productName": "JARVIS",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/dist/**/*"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "companion/",
        "to": "companion/"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": null,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist"
    },
    "dmg": {
      "title": "JARVIS",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
